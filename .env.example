# Non-secret defaults. Copy to .env and fill secrets locally.
# Never commit .env.

WEB_PORT=3000
BACKEND_PORT=8080

INSTRUCTIONS_PATH=/instructions
DATA_PATH=/data
BACKEND_URL=http://backend:8080
VISION_URL=http://vision:8081

INGEST_DPI=150
EMBEDDING_MODEL=dinov2-small
SEARCH_RERANK_MODEL=clip-vit-b-32
SEARCH_RERANK_CANDIDATES=100
TOP_K=12
SEARCH_HIST_WEIGHT=0.55
SEARCH_SILHOUETTE_WEIGHT=0.45
SEARCH_CHROMA_WEIGHT=0.0
SEARCH_KIND_BOOST=0.03

# Secrets (leave empty unless you use an optional catalog snapshot)
# REBRICKABLE_API_KEY=
